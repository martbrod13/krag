// Database schema of Krąg.
// Every model and field here must be described in docs/mapa-danych.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Role of a person in a care circle (krąg).
enum CircleRole {
  COORDINATOR // runs the circle, invites people and sets permissions
  FAMILY // family member with the permissions given by a coordinator
  CAREGIVER // professional caregiver or nurse
}

/// What a member of a circle may see and do.
enum Permission {
  PROFILE // care recipient profile: address, emergency contacts, doctor
  HEALTH // medicines, conditions, allergies, wellbeing notes, hospital stays
  TASKS // tasks and the day plan
  VISITS // caregiver visits and reports
  DOCUMENTS // discharge letters, prescriptions and other files
  MANAGE // circle settings, invitations, paired devices and the access log
}

/// Plan of a circle. Everything is free for now; payments come in stage 7.
enum Plan {
  FREE
  PREMIUM
}

enum AuditAction {
  VIEW
  CREATE
  UPDATE
  DELETE
}

/// A user account (data map, section 1). Care recipients have no account.
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  /// Profile photo. Required by the sign-in library; not used yet.
  image         String?
  phone         String?
  locale        String   @default("pl")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        Session[]
  accounts        Account[]
  memberships     Membership[]       @relation("MemberUser")
  invitedMembers  Membership[]       @relation("InvitedBy")
  invitationsSent Invitation[]
  devicePairings  DevicePairing[]
  pairedDevices   PairedDevice[]
  tasksCreated    Task[]             @relation("TaskCreator")
  tasksAssigned   Task[]             @relation("TaskAssignee")
  tasksDone       Task[]             @relation("TaskDoneBy")
  medsCreated     Medication[]       @relation("MedicationCreator")
  medsUpdated     Medication[]       @relation("MedicationEditor")
  medsConfirmed   MedicationIntake[]
  auditEntries    AuditLog[]
}

// The next three models are managed by the sign-in library (Better Auth).

/// A signed-in browser or phone (data map, section 8).
/// Ends on sign-out or after 30 days without use.
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// How a user signs in (data map, section 1). Krąg uses one-time email codes,
/// so there are no passwords or tokens from other sites in this table.
model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One-time sign-in codes, stored only as a hash (data map, section 8).
/// A code works once, for 10 minutes, and stops after 3 wrong attempts.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// A care circle: care for one person, their data and the people who can see it
/// (data map, section 2).
model CareCircle {
  id        String   @id @default(cuid())
  name      String
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipient   CareRecipient?
  memberships Membership[]
  invitations Invitation[]
  pairings    DevicePairing[]
  devices     PairedDevice[]
  tasks       Task[]
  medications Medication[]
  auditLog    AuditLog[]
}

/// A person's role and permissions in one circle (data map, section 2).
model Membership {
  id          String       @id @default(cuid())
  circleId    String
  userId      String
  role        CircleRole
  permissions Permission[]
  invitedById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  circle    CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user      User       @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([circleId, userId])
  @@index([userId])
}

/// A one-time invitation link to a circle, valid for 7 days (data map, section 2).
/// Only a hash of the token is stored; the link itself is known only to the invited person.
/// Used or expired invitations are deleted.
model Invitation {
  id          String       @id @default(cuid())
  circleId    String
  role        CircleRole
  permissions Permission[]
  email       String?
  tokenHash   String       @unique
  expiresAt   DateTime
  invitedById String?
  createdAt   DateTime     @default(now())

  circle    CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  invitedBy User?      @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([circleId])
}

/// The person cared for, one per circle (data map, section 3).
model CareRecipient {
  id            String    @id @default(cuid())
  circleId      String    @unique
  firstName     String
  birthDate     DateTime? @db.Date
  city          String?
  address       String?
  primaryDoctor String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  circle            CareCircle         @relation(fields: [circleId], references: [id], onDelete: Cascade)
  emergencyContacts EmergencyContact[]
}

/// Who to call in an emergency (data map, section 3). The senior screen shows
/// these numbers as big "call" buttons, in the order of position.
model EmergencyContact {
  id           String  @id @default(cuid())
  recipientId  String
  name         String
  phone        String
  relationship String?
  position     Int     @default(0)

  recipient CareRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
}

/// Something to do or something that happens in the care plan, e.g. "buy the
/// prescription" or "doctor's appointment" (data map, section 5). The day and
/// time are Polish time. The text may reveal health, so it is protected like
/// health data and never copied into the access log.
model Task {
  id           String    @id @default(cuid())
  circleId     String
  title        String
  note         String?
  /// The day in Polish time; null for tasks without a day.
  date         DateTime? @db.Date
  /// "HH:MM" in Polish time; only together with a day.
  time         String?
  assigneeId   String?
  showToSenior Boolean   @default(false)
  createdById  String?
  doneAt       DateTime?
  doneById     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  circle    CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdBy User?      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignee  User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  doneBy    User?      @relation("TaskDoneBy", fields: [doneById], references: [id], onDelete: SetNull)

  @@index([circleId, date])
}

/// A medicine the care recipient takes (data map, section 4). Health data:
/// only people with the HEALTH permission see it, and its name is never
/// copied into the access log. Days are Polish time.
model Medication {
  id           String    @id @default(cuid())
  circleId     String
  /// The medicine and its strength, e.g. "Metformina 500 mg".
  name         String
  /// How to take it, e.g. "po jedzeniu".
  note         String?
  /// Days of the week, 1 = Monday … 7 = Sunday; empty means every day.
  weekdays     Int[]
  /// The first and the last day of taking it; without a last day it goes on.
  startDate    DateTime  @db.Date
  endDate      DateTime? @db.Date
  /// Remind the senior on the senior screen at the medicine's times.
  showToSenior Boolean   @default(true)
  createdById  String?
  updatedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  circle    CareCircle         @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdBy User?              @relation("MedicationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?              @relation("MedicationEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  times     MedicationTime[]
  intakes   MedicationIntake[]

  @@index([circleId])
}

/// When to take a medicine and how much, e.g. 08:00 and "1 tabletka"
/// (data map, section 4). A medicine without times is taken when needed.
model MedicationTime {
  id           String  @id @default(cuid())
  medicationId String
  /// "HH:MM" in Polish time.
  time         String
  /// e.g. "1 tabletka", "½ tabletki", "10 kropli".
  amount       String?

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@unique([medicationId, time])
}

/// A dose that was taken, confirmed by a person from the circle or by the
/// senior on the senior screen (data map, section 4). Kept for 12 months
/// (data map, decision 8).
model MedicationIntake {
  id            String   @id @default(cuid())
  medicationId  String
  /// The day and the planned time ("HH:MM") of the dose, Polish time.
  date          DateTime @db.Date
  time          String
  takenAt       DateTime @default(now())
  /// The person who confirmed it; null when the senior did.
  confirmedById String?
  /// Confirmed on the senior's paired phone or tablet.
  bySenior      Boolean  @default(false)

  medication  Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  confirmedBy User?      @relation(fields: [confirmedById], references: [id], onDelete: SetNull)

  @@unique([medicationId, date, time])
}

/// A one-time QR code that pairs the care recipient's phone or tablet with a
/// circle (data map, section 2). It works once, for 30 minutes, and only a
/// hash of the code is stored. It is kept until it expires, so the family's
/// screen can show that pairing worked.
model DevicePairing {
  id          String    @id @default(cuid())
  circleId    String
  deviceName  String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  circle    CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([circleId])
}

/// The care recipient's phone or tablet, paired with a QR code, so the simple
/// senior screen works without an account or password (data map, section 2).
/// Only a hash of the device token is stored. Unpaired devices are deleted.
model PairedDevice {
  id         String    @id @default(cuid())
  circleId   String
  name       String
  tokenHash  String    @unique
  pairedById String?
  pairedAt   DateTime  @default(now())
  lastUsedAt DateTime?

  circle       CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  pairedBy     User?      @relation(fields: [pairedById], references: [id], onDelete: SetNull)
  auditEntries AuditLog[]

  @@index([circleId])
}

/// Who opened or changed data in a circle, and when (data map, section 8).
/// Kept for 12 months.
model AuditLog {
  id         String      @id @default(cuid())
  circleId   String
  userId     String?
  deviceId   String?
  /// The device's name at the time ("Tablet mamy"), so the log stays
  /// readable after the device is unpaired (data map, section 8).
  deviceName String?
  action     AuditAction
  entity     String
  /// For Membership entries: the member's user id.
  entityId   String?
  createdAt  DateTime    @default(now())

  circle CareCircle    @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  device PairedDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([circleId, createdAt])
}
