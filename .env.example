# Wzór pliku ze zmiennymi środowiskowymi.
# Skopiuj go jako .env.local i uzupełnij wartości.
# Plik .env.local nigdy nie trafia do repozytorium (jest w .gitignore).

# Adres bazy danych w Neon (projekt "krag", region Frankfurt).
# W Neon kliknij Connect, wyłącz "Connection pooling" i skopiuj adres.
DATABASE_URL="postgresql://uzytkownik:haslo@adres-z-neon/neondb?sslmode=require"

# Logowanie (Better Auth). Na Twoim komputerze nic nie trzeba wpisywać.
# Na serwerze (przed betą) ustawimy długi, losowy sekret i adres aplikacji.
# BETTER_AUTH_SECRET="długi-losowy-ciąg-znaków"
# BETTER_AUTH_URL="https://adres-aplikacji"
